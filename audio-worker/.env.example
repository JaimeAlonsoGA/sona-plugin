# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Stable Audio API Configuration
# Note: Not required when USE_TEST_AUDIO=true
STABLE_AUDIO_API_KEY=your-stable-audio-api-key-here
STABLE_AUDIO_API_URL=https://api.stability.ai/v2beta/stable-audio

# Test Mode Configuration
# Set to 'true' to use local test.mp3 instead of calling Stable Audio API
# This is useful for end-to-end testing without consuming API credits
USE_TEST_AUDIO=false

# Worker Configuration
MAX_CONCURRENT_JOBS=2
POLL_INTERVAL_MS=5000
JOB_TIMEOUT_MS=300000

# Storage Configuration
SUPABASE_STORAGE_BUCKET=audio-files
STORAGE_PATH_PREFIX=generated

# Retry Configuration
MAX_RETRIES=3
RETRY_DELAY_MS=2000

# Logging
LOG_LEVEL=info

# Open AI API Key
OPENAI_API_KEY=your-openai-api-key-here

# Replicate API Key
REPLICATE_API_TOKEN=your-replicate-api-key-here
