{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "buildCommand": "cd Plugin/ui && npm install && npm run build",
  "outputDirectory": "Plugin/ui/dist",
  "installCommand": "cd Plugin/ui && npm install",
  "framework": null,
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
