# Supabase Configuration
# Copy this file to .env.local and fill in your actual values

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# App URLs
# Production: https://plugin.sona.audio (plugin lives on subdomain)
# Development: http://localhost:5173
VITE_APP_URL=https://plugin.sona.audio
VITE_LANDING_URL=https://sona.audio

STABLE_AUDIO_API_KEY=your-stable-audio-api-key-here

# Stripe Configuration (use your test keys)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here